<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Types (no internal dependencies) -->
    <Compile Include="Core/Types/Vector2.fs" />
    <Compile Include="Core/Types/Vector3.fs" />
    <Compile Include="Core/Types/Rectangle.fs" />
    <Compile Include="Core/Types/Color.fs" />
    <Compile Include="Core/Types/Matrix.fs" />
    <Compile Include="Core/Types/GameTime.fs" />
    <Compile Include="Core/Types/Enums.fs" />

    <!-- Entity (depends on nothing) -->
    <Compile Include="Core/Entity/Yotsuba.fs" />

    <!-- Collections (depends on Entity) -->
    <Compile Include="Core/Collections/YTB.fs" />

    <!-- Components (depends on Types + Entity + Collections) -->
    <Compile Include="Core/Components/TransformComponent.fs" />
    <Compile Include="Core/Components/SpriteComponent2D.fs" />
    <Compile Include="Core/Components/RigidBodyComponent2D.fs" />
    <Compile Include="Core/Components/AnimationComponent2D.fs" />
    <Compile Include="Core/Components/ButtonComponent2D.fs" />
    <Compile Include="Core/Components/InputComponent.fs" />
    <Compile Include="Core/Components/ShaderComponent.fs" />
    <Compile Include="Core/Components/FontComponent2D.fs" />
    <Compile Include="Core/Components/TileMapComponent2D.fs" />
    <Compile Include="Core/Components/ModelComponent3D.fs" />
    <Compile Include="Core/Components/YTBModelComponent3D.fs" />
    <Compile Include="Core/Components/ScriptComponent.fs" />

    <!-- Scene (EventManager + EntityManager) -->
    <Compile Include="Core/Scene/EventManager.fs" />
    <Compile Include="Core/Scene/EntityManager.fs" />

    <!-- Systems Contract (depends on EntityManager + Components) -->
    <Compile Include="Core/Systems/Contract/ISystem.fs" />
    <Compile Include="Core/Systems/Contract/IRenderSystem.fs" />

    <!-- Concrete Systems (depends on Contract) -->
    <Compile Include="Core/Systems/PhysicsSystem2D.fs" />
    <Compile Include="Core/Systems/RenderSystem2D.fs" />
    <Compile Include="Core/Systems/AnimationSystem2D.fs" />
    <Compile Include="Core/Systems/InputSystem.fs" />
    <Compile Include="Core/Systems/ButtonSystem2D.fs" />
    <Compile Include="Core/Systems/CameraSystem.fs" />
    <Compile Include="Core/Systems/ScriptSystem.fs" />
    <Compile Include="Core/Systems/FontSystem2D.fs" />
    <Compile Include="Core/Systems/TileMapSystem2D.fs" />
    <Compile Include="Core/Systems/SystemBuilder.fs" />

    <!-- Scene (SceneFactory + Scene depend on Systems) -->
    <Compile Include="Core/Scene/SceneFactory.fs" />
    <Compile Include="Core/Scene/Scene.fs" />

    <!-- Benchmarks (depends on Scene) -->
    <Compile Include="Benchmarks/FullSceneBenchmarks.fs" />
    <Compile Include="Benchmarks/SystemBenchmarks.fs" />
    <Compile Include="Benchmarks/CollectionBenchmarks.fs" />
    <Compile Include="Benchmarks/EntityManagerBenchmarks.fs" />

    <!-- Program (always last) -->
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.*" />
  </ItemGroup>

</Project>
