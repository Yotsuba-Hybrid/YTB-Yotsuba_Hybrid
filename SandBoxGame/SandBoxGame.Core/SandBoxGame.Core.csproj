<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <Platforms>AnyCPU</Platforms>
    <Configurations>Debug;Release;YTB</Configurations>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Asegurar que tanto obj como objV2 se excluyan siempre de la compilación por defecto -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;objV2\**;bin\**;binV2\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'YTB'">
    <DefineConstants>DEBUG;YOTSUBA;YTB</DefineConstants>
  </PropertyGroup>

  <!-- Constantes KNI cuando UseV2=true -->
  <PropertyGroup Condition="'$(UseV2)' == 'true'">
    <DefineConstants>$(DefineConstants);KNI;BLAZOR_WEB;USE_GUMCOMMON;FULL_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>

  <!-- MonoGame -->
  <ItemGroup Condition="'$(UseV2)' != 'true'">
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.5-preview.*">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- KNI -->
  <ItemGroup Condition="'$(UseV2)' == 'true'">
    <PackageReference Include="nkast.Xna.Framework" Version="4.2.9001" PrivateAssets="All" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.2.9001" PrivateAssets="All" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.2.9001" PrivateAssets="All" />
    <PackageReference Include="nkast.Xna.Framework.Audio" Version="4.2.9001" PrivateAssets="All" />
    <PackageReference Include="nkast.Xna.Framework.Media" Version="4.2.9001" PrivateAssets="All" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="4.2.9001" PrivateAssets="All" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="4.2.9001" PrivateAssets="All" />
    <PackageReference Include="nkast.Xna.Framework.Devices" Version="4.2.9001" PrivateAssets="All" />
    <PackageReference Include="nkast.Xna.Framework.Storage" Version="4.2.9001" PrivateAssets="All" />
  </ItemGroup>

  <!-- ImGui: solo en plataformas NO-V2 (excluir BlazorGL/KNI) -->
  <ItemGroup Condition="'$(UseV2)' != 'true'">
    <ProjectReference Include="..\..\Hexa.NET.ImGui-2.2.4\Hexa.NET.ImGui-2.2.4\Hexa.NET.ImGuizmo\Hexa.NET.ImGuizmo.csproj" />
    <ProjectReference Include="..\..\Hexa.NET.ImGui-2.2.4\Hexa.NET.ImGui-2.2.4\Hexa.NET.ImGui\Hexa.NET.ImGui.csproj" />
    <ProjectReference Include="..\..\Hexa.NET.ImGui-2.2.4\Hexa.NET.ImGui-2.2.4\Hexa.NET.ImNodes\Hexa.NET.ImNodes.csproj" />
    <ProjectReference Include="..\..\Hexa.NET.ImGui-2.2.4\Hexa.NET.ImGui-2.2.4\Hexa.NET.ImPlot\Hexa.NET.ImPlot.csproj" />
    <ProjectReference Include="..\..\Hexa.NET.ImGui-2.2.4\Hexa.NET.ImGui-2.2.4\Hexa.NET.ImGui.Backends\Hexa.NET.ImGui.Backends.csproj" />
  </ItemGroup>

  <!-- Gum + YotsubaEngine — UseV2 == true -->
  <ItemGroup Condition="'$(UseV2)' == 'true'">
    <ProjectReference Include="..\..\Gum\GumCommon\GumCommon.csproj" AdditionalProperties="UseV2=true" />
    <ProjectReference Include="..\..\YotsubaEngine\YotsubaEngine.csproj" AdditionalProperties="UseV2=true" />
  </ItemGroup>

  <!-- Gum + YotsubaEngine — UseV2 != true -->
  <ItemGroup Condition="'$(UseV2)' != 'true'">
    <ProjectReference Include="..\..\Gum\GumCommon\GumCommon.csproj" AdditionalProperties="UseV2=false" />
    <ProjectReference Include="..\..\YotsubaEngine\YotsubaEngine.csproj" AdditionalProperties="UseV2=false" />
  </ItemGroup>

  <!-- MonoGameGum (MonoGame — UseV2 != true) -->
  <ItemGroup Condition="'$(UseV2)' != 'true'">
    <ProjectReference Include="..\..\Gum\MonoGameGum\MonoGameGum.csproj" />
  </ItemGroup>

  <!-- KniGum (KNI — UseV2 == true) -->
  <ItemGroup Condition="'$(UseV2)' == 'true'">
    <ProjectReference Include="..\..\Gum\MonoGameGum\KniGum\KniGum.csproj" AdditionalProperties="UseV2=true" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Content\GumProject\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Assets\Castle\" />
    <Folder Include="Assets\Effect\" />
    <Folder Include="Content\GumProject\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Localization\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Localization\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
