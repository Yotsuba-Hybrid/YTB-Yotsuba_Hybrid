<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TieredCompilation>true</TieredCompilation>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../SandBoxGame.Core/Assets/Icon.ico</ApplicationIcon>
    <AssemblyName>SandBoxGame</AssemblyName>
    <MonoGamePlatform>DesktopVK</MonoGamePlatform>
    <Configurations>Debug;Release;YTB;BlazorGL</Configurations>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>

  </PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'YTB'">
