<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;YTB</Configurations>
  </PropertyGroup>

  <!-- Si UseV2 == true se propaga hacia Core, de lo contrario se propaga como false -->
  <ItemGroup Condition="'$(UseV2)' == 'true'">
    <ProjectReference Include="..\SandBoxGame.Core\SandBoxGame.Core.csproj" 
                      AdditionalProperties="UseV2=true" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseV2)' != 'true'">
    <ProjectReference Include="..\SandBoxGame.Core\SandBoxGame.Core.csproj" 
                      AdditionalProperties="UseV2=false" />
  </ItemGroup>
</Project>
