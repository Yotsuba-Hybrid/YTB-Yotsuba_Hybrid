<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SandBoxGame_Web_BlazorGL</RootNamespace>
    <AssemblyName>SandBoxGame_Web_BlazorGL</AssemblyName>
    <UseV2>true</UseV2>
    <DefineConstants>$(DefineConstants);BLAZORGL</DefineConstants>
	<KniPlatform>BlazorGL</KniPlatform>
	<MonoGamePlatform>Web</MonoGamePlatform>
  </PropertyGroup>
  
  <PropertyGroup>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <!--<InvariantGlobalization>true</InvariantGlobalization>-->
  </PropertyGroup>

	<!-- 
		UseV2=true se propaga transitivamente a Core, YotsubaEngine, Gum, etc.
		IMPORTANTE: Las referencias explícitas a YotsubaEngine y GumCommon
		son necesarias para evitar que la resolución transitiva de MSBuild
		los compile sin UseV2 (lo que produciría DLLs con MonoGame).
	-->
	<ItemGroup>
		<ProjectReference Include="..\SandBoxGame.Core\SandBoxGame.Core.csproj" AdditionalProperties="UseV2=true" SetTargetFramework="TargetFramework=net8.0" />
		<ProjectReference Include="..\..\YotsubaEngine\YotsubaEngine.csproj" AdditionalProperties="UseV2=true" SetTargetFramework="TargetFramework=net8.0" />
		<ProjectReference Include="..\..\Gum\GumCommon\GumCommon.csproj" AdditionalProperties="UseV2=true" SetTargetFramework="TargetFramework=net8.0" />
		<ProjectReference Include="..\..\Gum\MonoGameGum\KniGum\KniGum.csproj" AdditionalProperties="UseV2=true" SetTargetFramework="TargetFramework=net8.0" />
	</ItemGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Pages\Index.razor.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="nkast.Xna.Framework.XR" Version="4.2.9001" />
    <PackageReference Include="nkast.Kni.Platform.Blazor.GL" Version="4.2.9001.2" />
    <!--<PackageReference Include="nkast.Xna.Framework.Content.Pipeline.Builder" Version="4.2.9001" />-->
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.17" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.17" PrivateAssets="all" />
  </ItemGroup>
	<Target Name="CopyCoreContent" AfterTargets="BuildContent" BeforeTargets="Build">
		<!-- Copiamos el proyecto Gum de Core/Content hacia wwwroot y wwwroot/Content -->
		<ItemGroup>
			<GumContentFiles Include="..\SandBoxGame.Core\Content\**\*.*" />
			<XnbContentFiles Include=".\bin\Debug\net8.0\Content\**\*.*" />
		</ItemGroup>
		
		<Copy SourceFiles="@(GumContentFiles)" DestinationFolder="wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(GumContentFiles)" DestinationFolder="wwwroot\Content\%(RecursiveDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(XnbContentFiles)" DestinationFolder="wwwroot\Content\%(RecursiveDir)" SkipUnchangedFiles="false" />
	</Target>

	<Import Project="..\SandBoxGame.Content\BuildContent.targets" />


</Project>
