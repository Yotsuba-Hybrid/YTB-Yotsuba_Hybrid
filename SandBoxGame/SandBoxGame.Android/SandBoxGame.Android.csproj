<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <ApplicationId>com.companyname.SandBoxGame</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AssemblyName>SandBoxGame</AssemblyName>
    <MonoGamePlatform>Android</MonoGamePlatform>
    <Configurations>Debug;Release;YTB</Configurations>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
	  <AndroidUseFastDeployment>false</AndroidUseFastDeployment>

  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
    <RunAOTCompilation>False</RunAOTCompilation>
    <AndroidEnableSGenConcurrent>False</AndroidEnableSGenConcurrent>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidEnableSGenConcurrent>False</AndroidEnableSGenConcurrent>
    <Optimize>True</Optimize>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='YTB|AnyCPU'">
    <RunAOTCompilation>False</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidEnableSGenConcurrent>False</AndroidEnableSGenConcurrent>
    <DebugSymbols>True</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>

  </PropertyGroup>
	<!--<ItemGroup>
		<AndroidAsset Include="..\DesktopGL\Content\GumProject\**\*.*" Link="Content\GumProject\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>-->
  <ItemGroup>
    <AndroidAsset Include="$(OutputPath)Content\**\*">
      <Link>Content\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AndroidAsset>
  </ItemGroup>
  <ItemGroup>
    <!-- ImGui font files (accessed via TitleContainer.OpenStream on Android) -->
    <AndroidAsset Include="..\..\YotsubaEngine\Fonts\GeistPixel-Square.ttf">
      <Link>Fonts\GeistPixel-Square.ttf</Link>
    </AndroidAsset>
    <AndroidAsset Include="..\..\YotsubaEngine\Fonts\NerdFontsSymbolsOnly.ttf">
      <Link>Fonts\NerdFontsSymbolsOnly.ttf</Link>
    </AndroidAsset>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.5-preview.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharedCode.Mobile\SharedCode.Mobile.csproj" />
  </ItemGroup>
  <Import Project="..\SandBoxGame.Content\BuildContent.targets" />
  <Import Project="..\..\Hexa.NET.ImGui-2.2.4\Hexa.NET.ImGui-2.2.4\CopyAllImGuiNatives.targets" />
</Project>